From 0a0ff6abcaf11bcf26173b92b7db56df6baf6528 Mon Sep 17 00:00:00 2001
From: mari <maricantdecide@gmail.com>
Date: Mon, 26 Sep 2022 05:04:29 -0300
Subject: [PATCH] Implement ConnectionErrorHandler.


diff --git a/proxy/src/main/java/io/github/souamari/zartema/ConnectionErrorHandler.java b/proxy/src/main/java/io/github/souamari/zartema/ConnectionErrorHandler.java
new file mode 100644
index 00000000..0ff8a284
--- /dev/null
+++ b/proxy/src/main/java/io/github/souamari/zartema/ConnectionErrorHandler.java
@@ -0,0 +1,22 @@
+package io.github.souamari.zartema;
+
+import java.net.InetSocketAddress;
+
+/**
+ * Written by mari <maricantdecide@gmail.com>, 26 Sep 2022
+ */
+public abstract class ConnectionErrorHandler {
+
+    public static ConnectionErrorHandler EMPTY = new ConnectionErrorHandler() {
+        @Override
+        public void handle(InetSocketAddress address, Type type) {
+        }
+    };
+
+    abstract public void handle(final InetSocketAddress address, Type type);
+
+    public enum Type {
+        UNEXPECTED_PACKET
+    }
+
+}
diff --git a/proxy/src/main/java/net/md_5/bungee/BungeeCord.java b/proxy/src/main/java/net/md_5/bungee/BungeeCord.java
index 1a534ff7..556fc4ba 100644
--- a/proxy/src/main/java/net/md_5/bungee/BungeeCord.java
+++ b/proxy/src/main/java/net/md_5/bungee/BungeeCord.java
@@ -153,6 +153,9 @@ public class BungeeCord extends ProxyServer
     @Getter
     private ConnectionThrottle connectionThrottle;
     private final ModuleManager moduleManager = new ModuleManager();
+    @Getter
+    @Setter
+    private io.github.souamari.zartema.ConnectionErrorHandler connectionErrorHandler = io.github.souamari.zartema.ConnectionErrorHandler.EMPTY;
 
     {
         // TODO: Proper fallback when we interface the manager
diff --git a/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java b/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
index 576f176f..174098a7 100644
--- a/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
+++ b/proxy/src/main/java/net/md_5/bungee/connection/InitialHandler.java
@@ -199,6 +199,7 @@ public class InitialHandler extends PacketHandler implements PendingConnection
     {
         if ( packet.packet == null )
         {
+            BungeeCord.getInstance().getConnectionErrorHandler().handle( this.getAddress(), io.github.souamari.zartema.ConnectionErrorHandler.Type.UNEXPECTED_PACKET );
             throw new QuietException( "Unexpected packet received during login process! " + BufUtil.dump( packet.buf, 16 ) );
         }
     }
